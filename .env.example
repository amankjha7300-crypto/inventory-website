# ============================================================
# S60 Inventory & Rewards - Environment Variables
# ============================================================
# Copy this to .env for local development.
# For Vercel/production: set these in the Vercel project dashboard
# under Settings → Environment Variables.

# --- DATABASE (REQUIRED for production) ---
# Get a free PostgreSQL from https://neon.tech  OR  https://supabase.com
# After creating a database, copy the connection string here.
DATABASE_URL=postgresql://user:password@host/dbname

# --- JWT Security (REQUIRED - change this to a random secret) ---
JWT_SECRET=change_this_to_a_long_random_secret_string_minimum_32_chars

# --- Token Expiry (in minutes, default 1440 = 24 hours) ---
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Default Super Admin Account ---
DEFAULT_ADMIN_EMAIL=admin@s60sviet.in
DEFAULT_ADMIN_PASSWORD=S60Admin@2026
DEFAULT_ADMIN_NAME=S60 Management

# --- CORS (use * for all, or comma-separated origins) ---
CORS_ORIGINS=*

# --- Environment ---
ENVIRONMENT=production

